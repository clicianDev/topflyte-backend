# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# Comma-separated origins allowed to call the API (the frontend URL[s]).
FRONTEND_URL=http://localhost:5173

# Production: a Top-Flyte-owned MongoDB connection string (e.g. MongoDB Atlas).
# Development: leave blank to use an embedded MongoDB stored in DEV_DB_PATH.
MONGODB_URI=
DEV_DB_PATH=.data/mongo
# Port of the embedded dev MongoDB (shared by `npm run dev`, `npm run migrate`, `npm run seed`).
DEV_DB_PORT=27018

# Apply pending migrations at startup. Blank = on in development, off in production
# (run `npm run migrate:dist` as a release step there).
MIGRATE_ON_BOOT=

# First administrator — created on boot only if no admin exists yet.
# Remove SEED_ADMIN_PASSWORD once the admin has logged in and changed it.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Top Flyte Admin

# --- Added in later phases (not read yet) -------------------------------------
# Phase 8/12  sessions:  SESSION_SECRET=, SESSION_TTL_HOURS=
# Phase 12    email:     EMAIL_PROVIDER_API_KEY=, EMAIL_FROM=, ADMIN_NOTIFY_EMAIL=
# Phase 13    storage:   FILE_STORAGE_BUCKET=, FILE_STORAGE_KEY=
